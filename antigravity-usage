#!/usr/bin/env python3
"""Antigravity Usage — conversation activity + estimated cost for Google
Antigravity.

Scope: Google Antigravity only (CLI + IDE). The legacy Gemini CLI is
deprecated (EOL 2026-06-18) and is intentionally NOT a data source here.

Reads Antigravity's local SQLite conversation stores directly and reports
per-month tokens and cost for the last 2 months — same one-line-per-month
format as oc-usage / ccusage. Both figures are estimates: Antigravity does
not persist per-token usage in any client-readable form (transcripts discard
UsageMetadata, the conversation SQLite stores carry step content but no
token counts, retrieveUserQuota returns REQUEST-type quota only). So tokens
come from per-turn assumptions × real per-model turn counts, and cost is
those tokens × live per-model rates from models.dev.

Zero external dependencies — Python 3 standard library only.

Design (SOLID): each concern is an isolated unit —
  PricingEngine       → live per-million rates from models.dev
  ConversationStore   → read + aggregate Antigravity's conversation DBs
  Renderer            → format output
"""

import argparse
import json
import sqlite3
import sys
import urllib.error
import urllib.request
from collections import defaultdict, Counter
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()

# Conversation stores. Antigravity CLI writes under antigravity-cli/; the
# Antigravity 2.0 IDE uses antigravity/ with the same SQLite schema.
CONVERSATION_DIRS = [
    HOME / ".gemini/antigravity-cli/conversations",
    HOME / ".gemini/antigravity/conversations",
    HOME / ".gemini/antigravity-ide/conversations",
]

# Report window: current month + previous (N-1) months.
MONTHS_BACK = 2

# Pricing cache (owner-only). Live per-million-token rates come from models.dev
# (same source oc-usage uses). Cache is XDG-style: ~/.cache/antigravity-usage/.
PRICING_CACHE = HOME / ".cache/antigravity-usage/models-dev.json"
MODELS_DEV_URL = "https://models.dev/api.json"


# ---------------------------------------------------------------------------
# HTTP helper
# ---------------------------------------------------------------------------

def http_get_json(url, timeout=30):
    """GET and parse JSON, or return None on any failure."""
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return json.loads(r.read().decode())
    except Exception:
        return None


# ---------------------------------------------------------------------------
# Minimal protobuf field reader (length-delimited + varint fields)
# ---------------------------------------------------------------------------

def _read_varint(buf, i):
    val = shift = 0
    while True:
        if i >= len(buf) or shift >= 70:
            raise ValueError("invalid protobuf varint")
        b = buf[i]
        val |= (b & 0x7F) << shift
        i += 1
        if not b & 0x80:
            return val, i
        shift += 7


def proto_fields(buf):
    """Yield (field_number, wire_type, raw_value) for every top-level field."""
    i, n = 0, len(buf)
    while i < n:
        tag, i = _read_varint(buf, i)
        field_num, wire = tag >> 3, tag & 0x07
        if wire == 0:  # varint
            val, i = _read_varint(buf, i)
            yield field_num, 0, val
        elif wire == 2:  # length-delimited
            length, i = _read_varint(buf, i)
            if i + length > n:
                raise ValueError("truncated protobuf field")
            yield field_num, 2, buf[i:i + length]
            i += length
        elif wire == 5:  # 32-bit
            i += 4
        elif wire == 1:  # 64-bit
            i += 8
        else:
            break


# ---------------------------------------------------------------------------
# PricingEngine — live per-million rates from models.dev (with stale fallback)
# ---------------------------------------------------------------------------

RATE_KEYS = ("input", "output", "cache_read", "cache_write")


def _has_rate(cost):
    """True when a models.dev cost dict carries any non-zero per-token rate."""
    return bool(cost) and any((cost.get(k) or 0) > 0 for k in RATE_KEYS)


class PricingEngine:
    """USD pricing using models.dev (the same source oc-usage uses).

    Rates are USD per 1,000,000 tokens. A model that models.dev prices at $0
    (a flat-rate subscription plan) is resolved to the real pay-as-you-go
    rate of the same model id under any paid provider — generically, with no
    provider or model names hardcoded. The on-disk cache at PRICING_CACHE is
    written after each successful fetch and used only as a fallback when the
    live fetch fails (offline); in that case the `stale` flag is set.
    """

    def __init__(self):
        self.stale = False
        self.data = self._load()
        self.models = self._index_real_rates(self.data)

    # --- loading -----------------------------------------------------------
    def _load(self):
        try:
            req = urllib.request.Request(
                MODELS_DEV_URL, headers={"User-Agent": "antigravity-usage"}
            )
            with urllib.request.urlopen(req, timeout=15) as resp:
                raw = resp.read()
            data = json.loads(raw)
            self._write_cache(raw)
            return data
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError):
            self.stale = True
            if PRICING_CACHE.exists():
                try:
                    return json.loads(PRICING_CACHE.read_text())
                except (json.JSONDecodeError, OSError):
                    pass
            return {}

    @staticmethod
    def _write_cache(raw):
        try:
            PRICING_CACHE.parent.mkdir(parents=True, exist_ok=True)
            PRICING_CACHE.write_bytes(raw)
            PRICING_CACHE.chmod(0o600)
        except OSError:
            pass  # caching is best-effort, never fatal

    @staticmethod
    def _index_real_rates(data):
        """model_id -> best non-zero cost dict across all providers.

        "best" = highest output rate so a subscription-priced model resolves
        to its real paid twin regardless of how many providers list the same
        id. Matches oc-usage's resolution strategy.
        """
        best = {}
        for prov in sorted(data):
            for model_id, m in (data[prov].get("models") or {}).items():
                cost = m.get("cost") or {}
                if not _has_rate(cost):
                    continue
                cur = best.get(model_id)
                if cur is None or (cost.get("output") or 0) > (cur.get("output") or 0):
                    best[model_id] = cost
        return best

    # --- resolution --------------------------------------------------------
    def rate(self, model):
        """Return cost dict {input, output, cache_read?, cache_write?} or None.

        Rates are USD per 1,000,000 tokens. Exact match first, then fuzzy
        (longest key wins, so 'gemini-3-flash-preview' beats 'gemini-3-flash'
        when matching 'gemini-3-flash-preview-thinking').
        """
        if not self.models:
            return None
        m = model.lower()
        if not m:
            return None
        # Exact (case-insensitive).
        if m in self.models:
            return self.models[m]
        # Fuzzy: longest key first (prefers specificity).
        for key in sorted(self.models, key=len, reverse=True):
            kl = key.lower()
            if kl in m or m in kl:
                return self.models[key]
        return None


# Approximate tokens per "model response" turn in agentic coding. Antigravity
# does not persist real counts; these are typical ratios seen in Claude Code /
# Cursor-style agents. Cost is an ESTIMATE — README calls this out. Order
# matters: first prefix match wins, so list more-specific prefixes first.
ASSUMED_TOKENS_PER_TURN = [
    ("gemini-2.5-flash-lite", 3000, 400),
    ("gemini-2.5-flash",      4000, 500),
    ("gemini-3-flash",        4000, 500),
    ("gemini-3.1-flash",      4000, 500),
    ("gemini-2.5-pro",        8000, 800),
    ("gemini-3-pro",          8000, 800),
    ("gemini-pro",            8000, 800),
    ("claude-opus",          10000, 900),
    ("claude-sonnet",         8000, 700),
    ("claude-haiku",          3000, 400),
    ("gpt-oss-120b",          6000, 600),
    ("gpt-oss",               6000, 600),
]
DEFAULT_ASSUMED_TOKENS = (5000, 600)


def assumed_tokens_for_turn(model):
    """Return (input, output) tokens for one model-response turn of `model`."""
    m = model.lower()
    for prefix, inp, out in ASSUMED_TOKENS_PER_TURN:
        if m.startswith(prefix):
            return inp, out
    return DEFAULT_ASSUMED_TOKENS


# ---------------------------------------------------------------------------
# ConversationStore — read Antigravity's local SQLite stores (read-only)
# ---------------------------------------------------------------------------

def _window_start_month():
    """Return YYYY-MM string for the first month in the report window.

    MONTHS_BACK=2 → window is the current month plus the previous one.
    String comparison works because YYYY-MM sorts chronologically.
    """
    now = datetime.now()
    month_index = now.year * 12 + (now.month - 1) - (MONTHS_BACK - 1)
    year, month0 = divmod(month_index, 12)
    return f"{year:04d}-{month0 + 1:02d}"


class ConversationStore:
    """Aggregates conversation activity from Antigravity's local stores.

    Reads `conversations/*.db` (SQLite) under both the CLI and Antigravity 2.0
    data dirs. All DBs are opened with `?mode=ro` so we never lock or mutate
    Antigravity's live state.
    """

    def __init__(self, dirs=None):
        self.dirs = [Path(d) for d in (dirs or CONVERSATION_DIRS)]

    def aggregate(self, pricing):
        """Return dict with by_month: {YYYY-MM: {tokens, cost}}.

        `tokens` is the estimated total (sum of assumed per-turn input+output
        across every model-response turn). `cost` is tokens × live rates.
        `pricing` is a PricingEngine; pass None to skip cost.
        """
        out = {
            "by_month": defaultdict(lambda: {
                "tokens": 0, "cost": 0.0, "_models": Counter(),
            }),
        }
        seen_paths = set()
        for d in self.dirs:
            if not d.exists():
                continue
            for db_path in sorted(d.glob("*.db")):
                if str(db_path) in seen_paths:
                    continue
                self._scan_one(db_path, out, pricing)
                seen_paths.add(str(db_path))
        return out

    def _scan_one(self, db_path, out, pricing):
        try:
            con = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        except sqlite3.Error:
            return
        try:
            # Per-model turn counts from gen_metadata BLOBs.
            # Structure: gen_metadata.data.field1.field19 = short model id
            # (e.g. "gemini-3-flash-a", "claude-sonnet-4-6").
            conv_models = Counter()
            try:
                cur = con.execute("SELECT data FROM gen_metadata")
                for (data,) in cur.fetchall():
                    if not isinstance(data, (bytes, bytearray)):
                        continue
                    try:
                        model = self._extract_model(data)
                    except ValueError:
                        print("warning: invalid model metadata skipped", file=sys.stderr)
                        continue
                    if model:
                        conv_models[model] += 1
            except sqlite3.Error:
                pass

            # Bucket by month using the DB's mtime (UTC). Per-step timestamps
            # live inside protobuf BLOBs without a published schema; mtime is a
            # robust proxy for "when this conversation was last active".
            try:
                m = db_path.stat().st_mtime
                month = datetime.fromtimestamp(m, tz=timezone.utc).strftime("%Y-%m")
                cell = out["by_month"][month]
                for model, turns in conv_models.items():
                    cell["_models"][model] += turns
                    inp, outp = assumed_tokens_for_turn(model)
                    cell["tokens"] += turns * (inp + outp)
                if pricing is not None:
                    cell["cost"] += self._estimate_cost(pricing, conv_models)
            except OSError:
                pass
        finally:
            try:
                con.close()
            except Exception:
                pass

    @staticmethod
    def _extract_model(gen_meta_blob):
        """gen_metadata.field1 (nested proto).field19 = short model id."""
        for fn, wire, val in proto_fields(gen_meta_blob):
            if fn == 1 and wire == 2:
                for sfn, swire, sval in proto_fields(val):
                    if sfn == 19 and swire == 2:
                        try:
                            return sval.decode("utf-8")
                        except Exception:
                            return None
        return None

    @staticmethod
    def _estimate_cost(pricing, model_turns):
        """Sum estimated cost across models using assumed per-turn tokens ×
        live rates."""
        if not pricing.models:
            return 0.0
        total = 0.0
        for model, turns in model_turns.items():
            rate = pricing.rate(model)
            if not rate:
                continue
            inp, out = assumed_tokens_for_turn(model)
            total += turns * (
                inp * rate["input"] / 1_000_000
                + out * rate["output"] / 1_000_000
            )
        return total


# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------

class Renderer:
    def activity(self, agg, pricing):
        """Render the per-month activity block in oc-usage / ccusage format:
        one header line, one bullet per month in the window showing estimated
        tokens and cost.

        Both figures are estimates: Antigravity doesn't persist per-token
        usage client-readably, so tokens come from the ASSUMED_TOKENS_PER_TURN
        table × real per-model turn counts, and cost is those tokens × live
        models.dev rates. Stale pricing (live fetch failed) is flagged on stderr.
        """
        print(f"📊 Antigravity Usage (last {MONTHS_BACK} months):")
        if pricing and pricing.stale:
            print(
                "  ⚠ pricing is STALE (live models.dev fetch failed; using cached prices)",
                file=sys.stderr,
            )
        start_month = _window_start_month()
        months = sorted(m for m in agg["by_month"] if m >= start_month)
        if not months:
            print(f"• no activity in the last {MONTHS_BACK} months")
            return
        for month in months:
            m = agg["by_month"][month]
            cost_str = f", Cost: ${m['cost']:,.2f}" if pricing and pricing.models else ", Cost: unknown"
            print(f"• {month}: {m['tokens']:,} estimated tokens{cost_str}")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    argparse.ArgumentParser(
        description="Conversation activity + estimated cost for Google Antigravity."
    ).parse_args()

    pricing = PricingEngine()
    Renderer().activity(ConversationStore().aggregate(pricing), pricing)


if __name__ == "__main__":
    main()
