# Rendering
# ---------------------------------------------------------------------------

class Renderer:
    def live(self, tier, email, buckets):
        print("🛰️  Antigravity — Live Account")
        who = f" ({email})" if email else ""
        print(f"• Plan: {tier or 'unknown'}{who}")
        if not buckets:
            print("• Quota: unavailable")
            return
        print("• Quota remaining (resets per window):")
        for b in sorted(buckets, key=lambda x: x.get("modelId", "")):
            frac = b.get("remainingFraction", 0)
            bar = self._bar(frac)
            reset = (b.get("resetTime", "") or "")[:16].replace("T", " ")
            print(f"    {b.get('modelId','?'):28} {bar} {frac*100:5.1f}%  ({b.get('tokenType','')}, reset {reset})")

    @staticmethod
    def _bar(frac, width=12):
        filled = int(round(frac * width))
        return "[" + "█" * filled + "·" * (width - filled) + "]"

    def activity(self, agg, pricing):
        """Render the per-month activity block (opencode-usage-style: header +
        one bullet per month in the window, with estimated cost).

        Cost is an estimate: Antigravity doesn't persist per-token usage
        client-readable, so we use assumed per-turn tokens × live LiteLLM
        rates. Stale pricing (live fetch failed) is flagged separately.
        """
        print(f"\n📊 Antigravity Usage (last {MONTHS_BACK} months):")
        if pricing and pricing.stale:
            print(
                f"  ⚠ pricing is STALE (live LiteLLM fetch failed; "
                f"using cached rates from {pricing.as_of})",
                file=sys.stderr,
            )
        start_month = _window_start_month()
        months = sorted(m for m in agg["by_month"] if m >= start_month)
        if not months:
            print(f"• no activity in the last {MONTHS_BACK} months")
            return
        for month in months:
            m = agg["by_month"][month]
            cost_str = f", est. ${m['cost']:,.2f}" if pricing and pricing.models else ""
            print(
                f"• {month}: {m['conversations']:,} conversations, "
                f"{m['steps']:,} steps{cost_str}"
            )


