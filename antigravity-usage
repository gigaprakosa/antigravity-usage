def main():
    parser = argparse.ArgumentParser(
        description="Live quota + conversation activity for Google Antigravity."
    )
    parser.add_argument(
        "--install-hook", action="store_true",
        help="(deprecated, no-op) Previously installed a usage-capture hook.",
    )
    parser.add_argument(
        "--no-live", action="store_true",
        help="Skip the live CloudCode account/quota lookup (history only).",
    )
    args = parser.parse_args()

    if args.install_hook:
        print(_format_deprecated_install_hook())
        return

    renderer = Renderer()
    pricing = PricingEngine()

    if not args.no_live:
        token = AntigravityAuth().access_token()
        if token:
            client = CloudCodeClient(token)
            tier, email = client.tier()
            renderer.live(tier, email, client.quota())
        else:
            print("🛰️  Antigravity — Live Account")
            print("• Unavailable: no valid credentials. Sign in via the Antigravity app/CLI, then retry.")

    renderer.activity(ConversationStore().aggregate(pricing), pricing)


if __name__ == "__main__":
    main()
